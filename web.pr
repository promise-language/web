enum JsValue `public `doc("Represents a dynamic JavaScript value.") {
  Undefined,
  Null,
  Bool(bool value),
  Number(f64 value),
  Str(string value),
  Object(i32 _js_ref),
  Array(i32 _js_ref),
  Function(i32 _js_ref),

  get is_undefined bool `public `doc("Returns true if this value is undefined.") {
    return this is Undefined;
  }

  get is_null bool `public `doc("Returns true if this value is null.") {
    return this is Null;
  }

  as_bool(this) bool? `public `doc("Returns the bool value, or none if not a Bool.") {
    return match this {
      Bool(v) => v, _ => none,
    };
  }

  as_number(this) f64? `public `doc("Returns the number value, or none if not a Number.") {
    return match this {
      Number(v) => v, _ => none,
    };
  }

  as_string(this) string? `public `doc("Returns the string value, or none if not a Str.") {
    return match this {
      Str(v) => v, _ => none,
    };
  }
}

_js_value_to_ref(JsValue value) i32 `target(web) {
  return match value {
    Undefined => _js_value_undefined(),
    Null => _js_value_null(),
    Bool(v) => _js_value_bool(v),
    Number(v) => _js_value_number(v),
    Str(v) => _js_value_str(v),
    Object(r) => r,
    Array(r) => r,
    Function(r) => r,
  };
}

_js_value_from_ref(i32 ref) JsValue `target(web) {
  tag := _js_value_tag(ref);
  if tag == 0 {
    _js_value_release(ref);
    return JsValue.Undefined;
  }
  if tag == 1 {
    _js_value_release(ref);
    return JsValue.Null;
  }
  if tag == 2 {
    lifted := JsValue.Bool(value: _js_value_get_bool(ref));
    _js_value_release(ref);
    return lifted;
  }
  if tag == 3 {
    lifted := JsValue.Number(value: _js_value_get_number(ref));
    _js_value_release(ref);
    return lifted;
  }
  if tag == 4 {
    lifted := JsValue.Str(value: _js_value_get_str(ref));
    _js_value_release(ref);
    return lifted;
  }
  if tag == 6 {
    return JsValue.Array(_js_ref: ref);
  }
  if tag == 7 {
    return JsValue.Function(_js_ref: ref);
  }
  return JsValue.Object(_js_ref: ref);
}

